---
import '../styles/global.css';
import { COMPANY_INFO } from '../data/companyData';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    author: string;
    tags: string[];
  };
  jsonLd?: Record<string, any>;
}

const {
  title = `${COMPANY_INFO.name} | ${COMPANY_INFO.tagline}`,
  description = "Partner IT Consultant & Software House terpercaya di Indonesia. Melayani pembuatan Web Kustom, Sistem Informasi (SI), ERP, HRIS, IoT Face ID Gate & Smart Locker.",
  image = "https://www.zagdigitalid.com/portfolio/westfit.jpg",
  canonicalUrl = `https://www.zagdigitalid.com${Astro.url.pathname.replace(/\/$/, '') || '/'}`,
  article,
  jsonLd
} = Astro.props;

// Default Organization & WebSite structured data
const baseJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.zagdigitalid.com/#organization",
      "name": "ZAG Digital Indonesia",
      "url": "https://www.zagdigitalid.com",
      "logo": "https://www.zagdigitalid.com/favicon.svg",
      "description": "Software House & IoT Engineering Specialist di Indonesia",
      "sameAs": [
        "https://instagram.com/zagdigital.id",
        "https://github.com/shiverzichida/zagdigitalid"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "telephone": "+6289619320345",
        "contactType": "sales",
        "areaServed": "ID",
        "availableLanguage": ["Indonesian", "English"]
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://www.zagdigitalid.com/#website",
      "url": "https://www.zagdigitalid.com",
      "name": "ZAG Digital Indonesia",
      "publisher": {
        "@id": "https://www.zagdigitalid.com/#organization"
      }
    }
  ]
};
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="software house indonesia, jasa pembuatan website, turnstile gate face id gym, smart locker iot, sistem informasi logistik, bill of lading system, hris cuti, web developer indonesia, zag digital, it consultant" />
    <meta name="author" content="ZAG Digital Indonesia" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#070a12" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="ZAG Digital Indonesia" />
    <meta property="og:locale" content="id_ID" />

    {article && (
      <>
        <meta property="article:published_time" content={article.publishedTime} />
        {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
        <meta property="article:author" content={article.author} />
        {article.tags.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd || baseJsonLd)} />
  </head>
  <body class="bg-[#070a12] text-slate-100 font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-cyan-500 selection:text-white min-h-screen flex flex-col relative overflow-x-hidden">
    <!-- Subtle Background Glows -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[600px] bg-radial-glow pointer-events-none -z-10 opacity-70"></div>
    <div class="glow-mesh -top-40 -left-40 w-96 h-96 bg-cyan-600/15 -z-10"></div>
    <div class="glow-mesh top-1/3 -right-40 w-[30rem] h-[30rem] bg-indigo-600/10 -z-10"></div>

    <slot />
  </body>
</html>
