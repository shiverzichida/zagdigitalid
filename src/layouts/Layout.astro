---
import '../styles/global.css';
import { COMPANY_INFO } from '../data/companyData';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${COMPANY_INFO.name} | ${COMPANY_INFO.tagline}`,
  description = "Partner IT Consultant & Software House terpercaya di Indonesia. Melayani pembuatan Web Kustom, Sistem Informasi (SI), ERP, HRIS, Domain & Cloud Hosting."
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="software house indonesia, jasa pembuatan website, sistem informasi logistik, HRIS cuti, bill of lading system, web developer indonesia, zag digital, it consultant" />
    <meta name="author" content="ZAG Digital Indonesia" />
    <meta name="theme-color" content="#0b0f19" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://zagdigital.id/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="ZAG Digital Indonesia" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-[#0b0f19] text-slate-100 font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-cyan-500 selection:text-white min-h-screen flex flex-col relative overflow-x-hidden">
    <!-- Subtle Background Glows -->
    <div class="fixed top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[600px] bg-radial-glow pointer-events-none -z-10 opacity-70"></div>
    <div class="glow-mesh -top-40 -left-40 w-96 h-96 bg-cyan-600/15 -z-10"></div>
    <div class="glow-mesh top-1/3 -right-40 w-[30rem] h-[30rem] bg-indigo-600/10 -z-10"></div>

    <slot />
  </body>
</html>
