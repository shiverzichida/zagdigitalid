---
import { COMPANY_INFO } from '../data/companyData';
import { ArrowRight, MessageSquare, Calculator, CheckCircle2, ShieldCheck, Sparkles, Terminal, Code2, Server } from 'lucide-react';
---

<section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      {/* Left Column: Copy & Value Proposition */}
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        {/* Badge */}
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-950/60 border border-cyan-500/30 text-cyan-300 text-xs font-medium mb-6 shadow-sm shadow-cyan-500/10">
          <span class="flex h-2 w-2 rounded-full bg-cyan-400 animate-ping"></span>
          <span class="font-semibold">IT Consultant & Software House</span>
          <span class="text-slate-500">•</span>
          <span class="text-slate-300">Indonesia</span>
        </div>

        {/* Main Headline */}
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.15] mb-6">
          Membangun <span class="bg-gradient-to-r from-cyan-400 via-sky-300 to-indigo-400 bg-clip-text text-transparent">Software & Sistem Informasi</span> Skala Enterprise
        </h1>

        {/* Subtitle */}
        <p class="text-base sm:text-lg text-slate-300 font-normal leading-relaxed mb-8 max-w-2xl">
          Dari sistem operasional logistik, modul Bill of Lading & invoice otomatis, HRIS cuti karyawan, hingga aplikasi web kustom berkecepatan tinggi. ZAG Digital mengeksekusi kebutuhan digital bisnis Anda secara presisi dan terukur.
        </p>

        {/* Action CTAs */}
        <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto mb-10">
          <a
            href={`https://wa.me/${COMPANY_INFO.whatsappNumber}?text=Halo%20ZAG%20Digital,%20saya%20tertarik%20untuk%20diskusi%20kebutuhan%20pembuatan%20sistem%20atau%20web.`}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl font-semibold text-white bg-gradient-to-r from-cyan-500 via-blue-600 to-indigo-600 hover:from-cyan-400 hover:to-indigo-500 shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 transition-all active:scale-[0.98]"
          >
            <MessageSquare className="w-5 h-5" />
            <span>Mulai Diskusi Proyek</span>
            <ArrowRight className="w-4 h-4 ml-1" />
          </a>

          <a
            href="#calculator"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl font-semibold text-slate-200 bg-slate-900/80 hover:bg-slate-800 border border-slate-700/80 hover:border-slate-600 transition-all"
          >
            <Calculator className="w-4 h-4 text-cyan-400" />
            <span>Hitung Estimasi Biaya</span>
          </a>
        </div>

        {/* Key Trust Signals */}
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-y-3 gap-x-6 pt-6 border-t border-slate-800/80 w-full text-xs text-slate-300">
          <div class="flex items-center gap-2">
            <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0" />
            <span>Garansi 30 Hari Minor</span>
          </div>
          <div class="flex items-center gap-2">
            <CheckCircle2 className="w-4 h-4 text-cyan-400 shrink-0" />
            <span>100% Hak Milik Source Code</span>
          </div>
          <div class="flex items-center gap-2">
            <CheckCircle2 className="w-4 h-4 text-indigo-400 shrink-0" />
            <span>Invoice & Kontrak Resmi</span>
          </div>
        </div>

      </div>

      {/* Right Column: Interactive Tech Architecture Preview Card */}
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-lg lg:max-w-none">
          
          {/* Glowing Aura Effect */}
          <div class="absolute -inset-1.5 bg-gradient-to-r from-cyan-500 to-indigo-600 rounded-3xl blur-xl opacity-30 group-hover:opacity-60 transition duration-1000"></div>

          {/* Window Container */}
          <div class="relative rounded-2xl bg-slate-900/90 border border-slate-800 shadow-2xl backdrop-blur-xl overflow-hidden">
            
            {/* Window Header */}
            <div class="flex items-center justify-between px-4 py-3 bg-slate-950/70 border-b border-slate-800/80">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
                <span class="ml-2 font-mono text-xs text-slate-400">zag-system-console.ts</span>
              </div>
              <span class="inline-flex items-center gap-1 text-[11px] font-mono text-emerald-400 bg-emerald-950/60 px-2 py-0.5 rounded border border-emerald-800/50">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                ONLINE 99.9%
              </span>
            </div>

            {/* Code / System Live Status Mockup */}
            <div class="p-5 font-mono text-xs text-slate-300 space-y-4">
              
              {/* Active Service Status */}
              <div class="bg-slate-950/60 p-3.5 rounded-xl border border-slate-800/70 space-y-2">
                <div class="flex items-center justify-between text-slate-400">
                  <span class="text-cyan-400 flex items-center gap-1.5">
                    <Terminal className="w-3.5 h-3.5" />
                    <span>Active Modules</span>
                  </span>
                  <span class="text-slate-500">v2.4.0</span>
                </div>
                
                <div class="space-y-1.5 pt-1 text-[11px]">
                  <div class="flex items-center justify-between">
                    <span class="text-slate-300">📦 Bill of Lading & Surat Jalan</span>
                    <span class="text-emerald-400 font-semibold">[READY]</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-slate-300">🧾 Auto-Invoice Generator PDF</span>
                    <span class="text-emerald-400 font-semibold">[SYNCED]</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-slate-300">👥 HRIS Cuti Online & Member</span>
                    <span class="text-emerald-400 font-semibold">[ACTIVE]</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-slate-300">🔐 Face ID Gate & Smart Locker IoT</span>
                    <span class="text-emerald-400 font-semibold">[VERIFIED]</span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-slate-300">☁️ Cloud Server & SSL Domain .id</span>
                    <span class="text-cyan-400 font-semibold">[PROTECTED]</span>
                  </div>
                </div>
              </div>

              {/* Code Snippet Highlight */}
              <div class="bg-[#0b0f19] p-3.5 rounded-xl border border-slate-800/80 font-mono text-[11px] leading-relaxed overflow-x-auto text-slate-300">
                <p class="text-slate-500">// ZAG Digital Engine Configuration</p>
                <p>
                  <span class="text-purple-400">const</span> clientProject = <span class="text-purple-400">await</span> zagEngine.<span class="text-blue-400">deploy</span>({`{`}
                </p>
                <p class="pl-4">
                  architecture: <span class="text-emerald-300">'High-Availability'</span>,
                </p>
                <p class="pl-4">
                  database: <span class="text-emerald-300">'PostgreSQL + Supabase'</span>,
                </p>
                <p class="pl-4">
                  freeMaintenance: <span class="text-cyan-300">30</span>, <span class="text-slate-500">// Days SLA</span>
                </p>
                <p class="pl-4">
                  sourceCodeOwnership: <span class="text-yellow-300">true</span>
                </p>
                <p>{`});`}</p>
              </div>

              {/* Live Metric Ribbon */}
              <div class="grid grid-cols-2 gap-3 pt-1">
                <div class="bg-cyan-950/20 border border-cyan-900/40 p-2.5 rounded-lg flex items-center gap-2.5">
                  <div class="p-1.5 rounded-md bg-cyan-500/20 text-cyan-400">
                    <Code2 className="w-4 h-4" />
                  </div>
                  <div>
                    <div class="text-[10px] text-slate-400">Development SLA</div>
                    <div class="text-xs font-bold text-cyan-300">Fast & On-Time</div>
                  </div>
                </div>

                <div class="bg-indigo-950/20 border border-indigo-900/40 p-2.5 rounded-lg flex items-center gap-2.5">
                  <div class="p-1.5 rounded-md bg-indigo-500/20 text-indigo-400">
                    <Server className="w-4 h-4" />
                  </div>
                  <div>
                    <div class="text-[10px] text-slate-400">Cloud Setup</div>
                    <div class="text-xs font-bold text-indigo-300">Domain + SSL Included</div>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
