---
import { FAQS, COMPANY_INFO } from '../data/companyData';
import { HelpCircle, ChevronDown, MessageSquare } from 'lucide-react';
---

<section id="faq" class="py-24 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Section Header */}
    <div class="text-center mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-800/40 text-cyan-400 text-xs font-semibold uppercase tracking-wider mb-4">
        <HelpCircle className="w-3.5 h-3.5" />
        <span>Tanya Jawab</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">
        Pertanyaan yang Sering Diajukan
      </h2>
      <p class="text-slate-300 text-base">
        Informasi seputar proses kerja sama, alur pengembangan, hingga garansi purna jual ZAG Digital.
      </p>
    </div>

    {/* FAQ Accordion List */}
    <div class="space-y-4">
      {FAQS.map((faq, index) => (
        <details class="group bg-slate-900/60 border border-slate-800 rounded-2xl p-6 [&_summary::-webkit-details-marker]:hidden transition-all duration-200 open:border-cyan-500/50 open:bg-slate-900/90">
          <summary class="flex items-center justify-between cursor-pointer text-base font-semibold text-white group-hover:text-cyan-400 transition-colors">
            <span class="pr-4">{faq.q}</span>
            <div class="w-8 h-8 rounded-full bg-slate-800 flex items-center justify-center shrink-0 group-open:rotate-180 transition-transform">
              <ChevronDown className="w-4 h-4 text-slate-400 group-hover:text-white" />
            </div>
          </summary>
          <div class="pt-4 mt-3 border-t border-slate-800/80 text-sm text-slate-300 leading-relaxed">
            {faq.a}
          </div>
        </details>
      ))}
    </div>

    {/* Still have questions banner */}
    <div class="mt-12 p-6 rounded-2xl bg-cyan-950/30 border border-cyan-800/40 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
      <div>
        <h4 class="text-base font-bold text-white mb-1">Punya kebutuhan sistem khusus atau pertanyaan lain?</h4>
        <p class="text-xs text-slate-400">Tim technical consultant kami siap berdiskusi langsung melalui WhatsApp.</p>
      </div>
      <a
        href={`https://wa.me/${COMPANY_INFO.whatsappNumber}?text=Halo%20ZAG%20Digital,%20saya%20memiliki%20pertanyaan%20seputar%20pengembangan%20sistem.`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-semibold text-white bg-cyan-500 hover:bg-cyan-400 transition-all shrink-0 shadow-md shadow-cyan-500/20"
      >
        <MessageSquare className="w-4 h-4" />
        <span>Tanya Langsung</span>
      </a>
    </div>

  </div>
</section>
