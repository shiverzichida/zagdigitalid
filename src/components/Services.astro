---
import { SERVICES, COMPANY_INFO } from '../data/companyData';
import { 
  Code2, 
  Layers, 
  Users2, 
  Cloud, 
  ShieldCheck, 
  Palette, 
  ScanFace,
  CheckCircle2, 
  ArrowUpRight 
} from 'lucide-react';

const iconMap: Record<string, any> = {
  Code2,
  Layers,
  Users2,
  Cloud,
  ShieldCheck,
  Palette,
  ScanFace
};
---

<section id="services" class="py-24 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    {/* Section Header */}
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-950/60 border border-cyan-800/40 text-cyan-400 text-xs font-semibold uppercase tracking-wider mb-4">
        Spesialisasi Kami
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight mb-4">
        Solusi IT & Pengembangan Sistem Menyeluruh
      </h2>
      <p class="text-slate-300 text-base sm:text-lg">
        Dari konsep awal, perancangan arsitektur database, implementasi kode bersih, hingga penyediaan cloud server dan pemeliharaan berkala.
      </p>
    </div>

    {/* Services Grid */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {SERVICES.map((service) => {
        const IconComponent = iconMap[service.icon] || Code2;
        return (
          <div
            class={`relative flex flex-col justify-between p-7 rounded-2xl transition-all duration-300 group ${
              service.highlight
                ? 'bg-gradient-to-b from-slate-900 to-slate-950 border-2 border-cyan-500/50 shadow-xl shadow-cyan-500/10 hover:border-cyan-400'
                : 'bg-slate-900/50 hover:bg-slate-900/80 border border-slate-800 hover:border-slate-700 shadow-lg'
            }`}
          >
            {service.highlight && (
              <div class="absolute -top-3 right-6 bg-gradient-to-r from-cyan-500 to-blue-600 text-white text-[10px] font-bold uppercase tracking-wider px-3 py-0.5 rounded-full shadow-md">
                Paling Diminati
              </div>
            )}

            <div>
              {/* Service Icon */}
              <div class="w-12 h-12 rounded-xl bg-cyan-950/80 border border-cyan-800/50 text-cyan-400 flex items-center justify-center mb-5 group-hover:scale-110 group-hover:bg-cyan-500 group-hover:text-white transition-all shadow-inner">
                <IconComponent className="w-6 h-6" />
              </div>

              {/* Title & Tagline */}
              <div class="mb-3">
                <span class="text-xs font-mono text-cyan-400 tracking-wider uppercase block mb-1">
                  {service.tagline}
                </span>
                <h3 class="text-xl font-bold text-white group-hover:text-cyan-300 transition-colors">
                  {service.title}
                </h3>
              </div>

              {/* Description */}
              <p class="text-sm text-slate-300 leading-relaxed mb-6">
                {service.description}
              </p>

              {/* Key Features List */}
              <div class="space-y-2.5 mb-6 pt-4 border-t border-slate-800/80">
                {service.features.map((feature) => (
                  <div class="flex items-start gap-2 text-xs text-slate-300">
                    <CheckCircle2 className="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" />
                    <span>{feature}</span>
                  </div>
                ))}
              </div>
            </div>

            <div>
              {/* Tech Stack Badges */}
              <div class="flex flex-wrap gap-1.5 mb-5">
                {service.techStack.map((tech) => (
                  <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-300 border border-slate-700/60">
                    {tech}
                  </span>
                ))}
              </div>

              {/* Action Button */}
              <a
                href={`https://wa.me/${COMPANY_INFO.whatsappNumber}?text=Halo%20ZAG%20Digital,%20saya%20tertarik%20konsultasi%20layanan:%20${encodeURIComponent(service.title)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-between w-full px-4 py-2.5 rounded-xl text-xs font-semibold text-slate-200 bg-slate-800/60 hover:bg-cyan-500 hover:text-white border border-slate-700 hover:border-cyan-400 transition-all group/btn"
              >
                <span>Konsultasikan Kebutuhan</span>
                <ArrowUpRight className="w-4 h-4 text-slate-400 group-hover/btn:text-white transition-colors" />
              </a>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
