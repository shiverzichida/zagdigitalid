---
import { BLOG_POSTS } from '../data/blogPosts';
import { BookOpen, ArrowRight, Clock, Calendar } from 'lucide-react';

const latestPosts = BLOG_POSTS.slice(0, 3);
---

<section class="py-20 bg-[#070a12] border-t border-slate-800/80 relative" id="blog">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12">
      <div class="space-y-3 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-medium">
          <BookOpen className="w-3.5 h-3.5" />
          <span>Wawasan & Edukasi Rekayasa IT</span>
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight">
          Artikel Pilihan & <span class="bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent">Studi Kasus</span>
        </h2>
        <p class="text-slate-400 text-sm sm:text-base leading-relaxed">
          Pelajari standar industri pembuatan website modern, otomasi hardware Face ID & Smart Locker, hingga sistem ERP logistik nasional.
        </p>
      </div>

      <div class="shrink-0">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-slate-900 border border-slate-800 hover:border-cyan-500/50 text-slate-200 hover:text-white text-xs sm:text-sm font-semibold transition-all group shadow-sm"
        >
          <span>Buka Semua Artikel</span>
          <ArrowRight className="w-4 h-4 text-cyan-400 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>
    </div>

    {/* Articles Grid */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {latestPosts.map((post) => (
        <article class="flex flex-col bg-slate-900/40 border border-slate-800/80 rounded-2xl p-6 hover:border-cyan-500/40 hover:bg-slate-900/70 transition-all duration-300 group shadow-md hover:shadow-cyan-950/20">
          <div class="flex items-center justify-between gap-2 mb-4">
            <span class="px-2.5 py-1 rounded-md bg-slate-800/80 text-cyan-300 text-xs font-medium border border-slate-700/60">
              {post.category}
            </span>
            <span class="text-[11px] text-slate-400 flex items-center gap-1 font-mono">
              <Clock className="w-3 h-3 text-slate-400" />
              {post.readTime}
            </span>
          </div>

          <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-cyan-300 transition-colors line-clamp-2 mb-3 leading-snug">
            <a href={`/blog/${post.slug}`}>
              {post.title}
            </a>
          </h3>

          <p class="text-slate-300 text-xs sm:text-sm line-clamp-3 mb-6 flex-1 leading-relaxed">
            {post.excerpt}
          </p>

          <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between mt-auto text-xs">
            <span class="text-slate-400 font-mono text-[11px] flex items-center gap-1">
              <Calendar className="w-3 h-3" />
              {post.publishDate}
            </span>
            <a
              href={`/blog/${post.slug}`}
              class="inline-flex items-center gap-1 text-cyan-400 group-hover:text-cyan-300 font-semibold group-hover:translate-x-1 transition-transform"
            >
              <span>Baca Selengkapnya</span>
              <ArrowRight className="w-3.5 h-3.5" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
