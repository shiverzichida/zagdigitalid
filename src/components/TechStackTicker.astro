---
import { TECH_STACK_LOGOS } from '../data/companyData';
---

<section class="py-10 border-y border-slate-800/80 bg-slate-950/40 backdrop-blur-sm relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      
      <div class="shrink-0 flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-slate-400">
        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
        <span>Modern Tech Stack We Master:</span>
      </div>

      <div class="w-full flex-1 overflow-x-auto scrollbar-none py-2">
        <div class="flex items-center gap-3 sm:gap-4 flex-nowrap">
          {TECH_STACK_LOGOS.map((tech) => (
            <div class="shrink-0 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-slate-900/80 border border-slate-800 text-xs font-medium text-slate-300 hover:border-cyan-500/50 hover:text-white transition-all shadow-sm">
              <span class="text-sm">{tech.icon}</span>
              <span class="font-semibold">{tech.name}</span>
              <span class="text-[10px] text-slate-500 font-mono">({tech.category})</span>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
