---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer.astro';
import WhatsAppFloating from '../../components/WhatsAppFloating.astro';
import { BLOG_POSTS, type BlogPost } from '../../data/blogPosts';
import { COMPANY_INFO } from '../../data/companyData';
import { renderMarkdown } from '../../lib/markdown';
import {
  Calendar,
  Clock,
  ArrowLeft,
  ArrowRight,
  Share2,
  Tag,
  ShieldCheck,
  MessageSquare,
  Sparkles,
  ChevronRight
} from 'lucide-react';

export async function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const htmlContent = renderMarkdown(post.content);

// Related posts (excluding current post)
const relatedPosts = BLOG_POSTS.filter((p) => p.slug !== post.slug).slice(0, 2);

// Structured data for Google Rich Snippets
const postJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "headline": post.title,
      "description": post.excerpt,
      "datePublished": post.isoDate,
      "dateModified": post.isoDate,
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": `https://www.zagdigitalid.com/blog/${post.slug}`
      },
      "author": {
        "@type": "Organization",
        "name": "ZAG Digital Indonesia",
        "url": "https://www.zagdigitalid.com"
      },
      "publisher": {
        "@type": "Organization",
        "name": "ZAG Digital Indonesia",
        "url": "https://www.zagdigitalid.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://www.zagdigitalid.com/favicon.svg"
        }
      },
      "keywords": post.tags.join(', ')
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "https://www.zagdigitalid.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Blog",
          "item": "https://www.zagdigitalid.com/blog"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": post.title,
          "item": `https://www.zagdigitalid.com/blog/${post.slug}`
        }
      ]
    }
  ]
};
---

<Layout
  title={`${post.title} | ${COMPANY_INFO.name}`}
  description={post.excerpt}
  canonicalUrl={`https://www.zagdigitalid.com/blog/${post.slug}`}
  article={{
    publishedTime: post.isoDate,
    author: post.author.name,
    tags: post.tags
  }}
  jsonLd={postJsonLd}
>
  <Navbar client:load />

  <main class="pt-28 pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      {/* Breadcrumb Navigation */}
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-8 overflow-x-auto whitespace-nowrap pb-2">
        <a href="/" class="hover:text-cyan-400 transition-colors">Beranda</a>
        <ChevronRight className="w-3.5 h-3.5 text-slate-600 shrink-0" />
        <a href="/blog" class="hover:text-cyan-400 transition-colors">Blog</a>
        <ChevronRight className="w-3.5 h-3.5 text-slate-600 shrink-0" />
        <span class="text-slate-200 font-medium truncate max-w-xs">{post.category}</span>
      </nav>

      {/* Article Header */}
      <header class="space-y-6 mb-12">
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-semibold">
            {post.category}
          </span>
          <span class="text-slate-400 text-xs flex items-center gap-1 font-mono">
            <Clock className="w-3 h-3 text-slate-400" />
            {post.readTime}
          </span>
        </div>

        <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white tracking-tight leading-tight">
          {post.title}
        </h1>

        <p class="text-slate-300 text-base sm:text-lg leading-relaxed border-l-2 border-cyan-500 pl-4 py-1">
          {post.excerpt}
        </p>

        {/* Author & Date Bar */}
        <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-slate-800 text-xs text-slate-400">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-cyan-500 to-blue-600 p-[1.5px]">
              <div class="w-full h-full bg-[#0b0f19] rounded-full flex items-center justify-center font-bold text-cyan-400 text-xs">
                ZAG
              </div>
            </div>
            <div>
              <div class="font-semibold text-white">{post.author.name}</div>
              <div class="text-[11px] text-slate-400">{post.author.role}</div>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <span class="flex items-center gap-1.5 font-mono">
              <Calendar className="w-3.5 h-3.5 text-slate-400" />
              {post.publishDate}
            </span>
            <a
              href={`https://wa.me/?text=${encodeURIComponent(`${post.title} - Baca selengkapnya di: https://www.zagdigitalid.com/blog/${post.slug}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-900 border border-slate-800 text-slate-300 hover:text-white hover:border-slate-700 transition-colors"
              title="Bagikan ke WhatsApp"
            >
              <Share2 className="w-3.5 h-3.5" />
              <span>Share</span>
            </a>
          </div>
        </div>
      </header>

      {/* Main Content Reader */}
      <article class="prose-container bg-slate-900/30 border border-slate-800/80 rounded-3xl p-6 sm:p-10 mb-12 shadow-xl shadow-black/20">
        <div set:html={htmlContent} />

        {/* Tags */}
        <div class="mt-12 pt-6 border-t border-slate-800 flex flex-wrap items-center gap-2">
          <span class="text-xs text-slate-400 flex items-center gap-1 mr-2">
            <Tag className="w-3.5 h-3.5 text-slate-400" />
            Kata Kunci:
          </span>
          {post.tags.map((tag) => (
            <span class="px-2.5 py-1 rounded-md bg-slate-800/60 text-slate-300 text-xs border border-slate-700/60">
              #{tag}
            </span>
          ))}
        </div>
      </article>

      {/* Conversion Box: WhatsApp CTA */}
      <section class="rounded-3xl bg-gradient-to-r from-cyan-950/60 via-slate-900 to-blue-950/60 border border-cyan-500/30 p-8 sm:p-10 mb-16 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl">
        <div class="space-y-2 max-w-xl">
          <div class="inline-flex items-center gap-1.5 text-cyan-400 text-xs font-semibold">
            <ShieldCheck className="w-4 h-4" />
            <span>Garansi Resmi & 100% Hak Milik Kode</span>
          </div>
          <h3 class="text-xl sm:text-2xl font-bold text-white">
            Konsultasikan Kebutuhan Sistem & Website Bisnis Anda
          </h3>
          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed">
            Diskusikan arsitektur sistem, estimasi biaya, atau solusi IoT bersama tim konsultan ZAG Digital tanpa komitmen awal.
          </p>
        </div>

        <a
          href={`https://wa.me/${COMPANY_INFO.whatsappNumber}?text=Halo%20ZAG%20Digital,%20saya%20tertarik%20dengan%20artikel%20"${encodeURIComponent(post.title)}"%20dan%20ingin%20konsultasi.`}
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-semibold text-sm shadow-lg shadow-emerald-500/20 transition-all active:scale-[0.98]"
        >
          <MessageSquare className="w-4 h-4" />
          <span>Tanya Tim ZAG Digital</span>
        </a>
      </section>

      {/* Related Posts */}
      {relatedPosts.length > 0 && (
        <section class="border-t border-slate-800 pt-12">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-bold text-white">Artikel Rekomendasi Terkait</h3>
            <a href="/blog" class="text-xs text-cyan-400 hover:text-cyan-300 font-semibold inline-flex items-center gap-1">
              <span>Semua Blog</span>
              <ArrowRight className="w-3 h-3" />
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {relatedPosts.map((rel) => (
              <a
                href={`/blog/${rel.slug}`}
                class="block p-5 rounded-2xl bg-slate-900/50 border border-slate-800 hover:border-slate-700 hover:bg-slate-900/80 transition-all group"
              >
                <div class="flex items-center justify-between gap-2 text-xs text-slate-400 mb-2 font-mono">
                  <span class="text-cyan-400">{rel.category}</span>
                  <span>{rel.readTime}</span>
                </div>
                <h4 class="text-sm sm:text-base font-bold text-white group-hover:text-cyan-300 transition-colors line-clamp-2 mb-2">
                  {rel.title}
                </h4>
                <p class="text-xs text-slate-300 line-clamp-2">
                  {rel.excerpt}
                </p>
              </a>
            ))}
          </div>
        </section>
      )}

      {/* Back to Blog Button */}
      <div class="mt-12 text-center">
        <a
          href="/blog"
          class="inline-flex items-center gap-2 text-xs font-semibold text-slate-400 hover:text-white transition-colors"
        >
          <ArrowLeft className="w-4 h-4" />
          <span>Kembali ke Halaman Blog</span>
        </a>
      </div>
    </div>
  </main>

  <Footer />
  <WhatsAppFloating />
</Layout>
