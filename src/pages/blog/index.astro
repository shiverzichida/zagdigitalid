---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar';
import Footer from '../../components/Footer.astro';
import WhatsAppFloating from '../../components/WhatsAppFloating.astro';
import { BLOG_POSTS } from '../../data/blogPosts';
import { COMPANY_INFO } from '../../data/companyData';
import { Calendar, Clock, ArrowRight, Tag, BookOpen, Sparkles, MessageSquare } from 'lucide-react';

const featuredPost = BLOG_POSTS[0];
const regularPosts = BLOG_POSTS.slice(1);
---

<Layout
  title={`Blog & Wawasan Digital | ${COMPANY_INFO.name}`}
  description="Artikel, studi kasus rekayasa software, solusi IoT turnstile gate & smart locker, serta panduan pengembangan website profesional di Indonesia."
  canonicalUrl="https://www.zagdigitalid.com/blog"
>
  <Navbar client:load />

  <main class="pt-28 pb-20">
    {/* Hero Section */}
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 text-xs font-medium">
          <BookOpen className="w-3.5 h-3.5" />
          <span>Wawasan & Edukasi Rekayasa Digital</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Artikel, Solusi IT & <span class="bg-gradient-to-r from-cyan-400 via-blue-500 to-indigo-400 bg-clip-text text-transparent">Studi Kasus Nyata</span>
        </h1>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Edukasi praktis seputar pembuatan website modern, otomasi hardware IoT (Face ID Turnstile & Smart Locker), sistem ERP logistik, hingga tips memilih vendor IT profesional.
        </p>
      </div>
    </section>

    {/* Featured Post Spotlight */}
    {featuredPost && (
      <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
        <div class="relative group rounded-3xl bg-gradient-to-b from-slate-900/90 to-slate-950/90 border border-cyan-500/30 p-6 sm:p-10 shadow-2xl shadow-cyan-950/30 overflow-hidden hover:border-cyan-500/50 transition-all duration-300">
          <div class="absolute -right-20 -top-20 w-80 h-80 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none group-hover:bg-cyan-500/15 transition-all"></div>
          
          <div class="relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">
            <div class="space-y-4 max-w-3xl">
              <div class="flex flex-wrap items-center gap-2.5">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-xs font-semibold">
                  <Sparkles className="w-3 h-3" />
                  Artikel Utama
                </span>
                <span class="px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-300 text-xs">
                  {featuredPost.category}
                </span>
                <span class="text-slate-400 text-xs flex items-center gap-1">
                  <Clock className="w-3 h-3 text-slate-400" />
                  {featuredPost.readTime}
                </span>
              </div>

              <h2 class="text-2xl sm:text-3xl font-extrabold text-white group-hover:text-cyan-300 transition-colors leading-snug">
                <a href={`/blog/${featuredPost.slug}`}>
                  {featuredPost.title}
                </a>
              </h2>

              <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
                {featuredPost.excerpt}
              </p>

              <div class="flex items-center gap-4 text-xs text-slate-400 pt-2">
                <span class="font-medium text-slate-200">{featuredPost.author.name}</span>
                <span>•</span>
                <span class="flex items-center gap-1">
                  <Calendar className="w-3.5 h-3.5" />
                  {featuredPost.publishDate}
                </span>
              </div>
            </div>

            <div class="w-full lg:w-auto shrink-0">
              <a
                href={`/blog/${featuredPost.slug}`}
                class="inline-flex items-center justify-center gap-2 w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-gradient-to-r from-cyan-500 to-blue-600 text-white font-semibold text-sm hover:from-cyan-400 hover:to-blue-500 shadow-lg shadow-cyan-500/25 transition-all group-hover:translate-x-1"
              >
                <span>Baca Artikel Lengkap</span>
                <ArrowRight className="w-4 h-4" />
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    {/* Articles Grid */}
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-800">
        <h3 class="text-xl font-bold text-white flex items-center gap-2">
          <span>Semua Artikel & Studi Kasus</span>
          <span class="text-xs font-mono font-normal text-cyan-400 px-2 py-0.5 rounded-md bg-cyan-950/80 border border-cyan-800/50">
            {BLOG_POSTS.length} Post
          </span>
        </h3>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {BLOG_POSTS.map((post) => (
          <article class="flex flex-col bg-slate-900/50 border border-slate-800/80 rounded-2xl p-6 hover:border-slate-700 hover:bg-slate-900/80 transition-all duration-300 group shadow-md hover:shadow-cyan-950/20">
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="px-2.5 py-1 rounded-md bg-slate-800/80 text-cyan-300 text-xs font-medium border border-slate-700/60">
                {post.category}
              </span>
              <span class="text-[11px] text-slate-400 flex items-center gap-1 font-mono">
                <Clock className="w-3 h-3 text-slate-400" />
                {post.readTime}
              </span>
            </div>

            <h4 class="text-lg font-bold text-white group-hover:text-cyan-400 transition-colors line-clamp-2 mb-3 leading-snug">
              <a href={`/blog/${post.slug}`}>
                {post.title}
              </a>
            </h4>

            <p class="text-slate-300 text-xs sm:text-sm line-clamp-3 mb-6 flex-1 leading-relaxed">
              {post.excerpt}
            </p>

            <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between mt-auto text-xs">
              <span class="text-slate-400 font-mono text-[11px]">{post.publishDate}</span>
              <a
                href={`/blog/${post.slug}`}
                class="inline-flex items-center gap-1 text-cyan-400 group-hover:text-cyan-300 font-semibold group-hover:translate-x-1 transition-transform"
              >
                <span>Baca</span>
                <ArrowRight className="w-3.5 h-3.5" />
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    {/* Lead Generation CTA Card */}
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-20">
      <div class="rounded-3xl bg-gradient-to-r from-blue-950/60 via-slate-900 to-cyan-950/60 border border-slate-800 p-8 sm:p-12 text-center relative overflow-hidden">
        <div class="max-w-2xl mx-auto space-y-4">
          <h3 class="text-2xl sm:text-3xl font-extrabold text-white">
            Punya Rencana Mengembangkan Sistem atau Website?
          </h3>
          <p class="text-slate-300 text-sm leading-relaxed">
            Dapatkan estimasi anggaran transparan, demo sistem (Face ID Gate / Logistik), serta konsultasi arsitektur langsung bersama Tech Specialist ZAG Digital.
          </p>
          <div class="pt-2">
            <a
              href={`https://wa.me/${COMPANY_INFO.whatsappNumber}?text=Halo%20ZAG%20Digital,%20saya%20membaca%20artikel%20di%20blog%20dan%20ingin%20konsultasi%20pembuatan%20sistem/website.`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-semibold text-sm shadow-lg shadow-emerald-500/20 transition-all active:scale-[0.98]"
            >
              <MessageSquare className="w-4 h-4" />
              <span>Konsultasi WhatsApp Sekarang</span>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <WhatsAppFloating />
</Layout>
